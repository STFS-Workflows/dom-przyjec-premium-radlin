{
  "name": "STFS — Follow-up po braku odpowiedzi",
  "nodes": [
    {
      "id": "6ceddc63-5a19-4315-ada7-fb3b48582f1b",
      "name": "Notatka: konfiguracja",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        -40
      ],
      "parameters": {
        "content": "## Follow-up sekwencyjny\n\n**Trigger:** Schedule — sprawdza codziennie leady bez odpowiedzi.\n\n**Do zrobienia:**\n1. Podmień \"Pobierz leady bez odpowiedzi\" na zapytanie do Twojego CRM/bazy.\n2. Ustaw liczbę dni bez odpowiedzi w węźle IF.\n3. Dostosuj treść follow-upu.",
        "height": 300,
        "width": 380,
        "color": 4
      }
    },
    {
      "id": "91c2bb8f-fc1c-490c-9a7f-aea45a2dbe3b",
      "name": "Codziennie 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "2472bdb3-1fd5-4b45-9802-24be9fa70317",
      "name": "Pobierz leady bez odpowiedzi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-CRM.example.com/api/leads?status=no_reply",
        "sendBody": false,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Podmień na realny endpoint CRM/bazy."
    },
    {
      "id": "19f5c95a-fe56-461d-81bd-7f7e632e77ad",
      "name": "Minęło 3+ dni?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "4c88ee02-cea7-4afb-9397-5d61d436d3f2",
              "leftValue": "={{ $json.daysSinceContact }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "27ae361f-bd74-440a-aad5-cf16bee2cb16",
      "name": "AI: napisz follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Model generuje krótką, nienachalną wiadomość follow-up."
    },
    {
      "id": "7a9dfa8f-abce-4204-ba02-661258a5b937",
      "name": "Wyślij follow-up",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "fromEmail": "hello@stfs.studio",
        "toEmail": "={{ $json.email }}",
        "subject": "Czy nadal jesteś zainteresowany/a?",
        "text": "={{ $json.aiResponse }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Codziennie 9:00": {
      "main": [
        [
          {
            "node": "Pobierz leady bez odpowiedzi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pobierz leady bez odpowiedzi": {
      "main": [
        [
          {
            "node": "Minęło 3+ dni?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Minęło 3+ dni?": {
      "main": [
        [
          {
            "node": "AI: napisz follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI: napisz follow-up": {
      "main": [
        [
          {
            "node": "Wyślij follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
