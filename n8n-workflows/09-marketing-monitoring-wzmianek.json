{
  "name": "STFS — Monitoring wzmianek o marce",
  "nodes": [
    {
      "id": "e0e4a64a-9bf4-4f7f-abd3-b43752a5343a",
      "name": "Notatka: konfiguracja",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        -40
      ],
      "parameters": {
        "content": "## Monitoring marki\n\n**Trigger:** Schedule — co kilka godzin.\n\n**Do zrobienia:**\n1. Podmień \"Pobierz wzmianki\" na API narzędzia monitoringu (Brand24, Mention) lub RSS/wyszukiwarkę.\n2. Skonfiguruj Slack do alertów o negatywnym sentymencie.",
        "height": 300,
        "width": 380,
        "color": 4
      }
    },
    {
      "id": "cd179f4f-9959-4a3c-8473-cf22e5c34d7c",
      "name": "Co 4 godziny",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */4 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "172728d5-cc3e-4b83-bd18-940bf97c79bb",
      "name": "Pobierz wzmianki",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-MONITORING.example.com/api/mentions",
        "sendBody": false,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Podmień na Brand24/Mention/RSS."
    },
    {
      "id": "8b286974-576c-4166-addb-36d6ccd58b97",
      "name": "AI: analiza sentymentu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Model klasyfikuje każdą wzmiankę jako pozytywną/neutralną/negatywną."
    },
    {
      "id": "da87e059-52ff-4fa2-bf79-8a2b2ed61321",
      "name": "Czy sentyment negatywny?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "fa4e65f1-7963-4e0f-902e-89120ad58324",
              "leftValue": "={{ $json.sentiment }}",
              "rightValue": "negative",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "2e7ab911-a0f9-4c2a-bcfd-b132f463fdf4",
      "name": "Alert: negatywna wzmianka",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "mode": "name",
          "value": "#automatyzacje"
        },
        "text": "⚠️ Negatywna wzmianka o marce: {{$json.text}}",
        "otherOptions": {}
      }
    }
  ],
  "connections": {
    "Co 4 godziny": {
      "main": [
        [
          {
            "node": "Pobierz wzmianki",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pobierz wzmianki": {
      "main": [
        [
          {
            "node": "AI: analiza sentymentu",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI: analiza sentymentu": {
      "main": [
        [
          {
            "node": "Czy sentyment negatywny?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Czy sentyment negatywny?": {
      "main": [
        [
          {
            "node": "Alert: negatywna wzmianka",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}