{
  "name": "STFS — Alerty o stanach magazynowych",
  "nodes": [
    {
      "id": "6164f02c-cfec-4b3d-98dd-02da347108da",
      "name": "Notatka: konfiguracja",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        -40
      ],
      "parameters": {
        "content": "## Alerty magazynowe\n\n**Trigger:** Schedule — codzienna kontrola stanów.\n\n**Do zrobienia:**\n1. Podmień \"Pobierz stany magazynowe\" na API Twojego systemu (Baselinker/Shopify/WMS).\n2. Ustaw próg minimalnego stanu w węźle IF.",
        "height": 300,
        "width": 380,
        "color": 4
      }
    },
    {
      "id": "7a91303a-2f56-4068-a2af-b3a79a88fcb6",
      "name": "Codziennie 6:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "c202068a-6907-4da3-ad62-482f2c723a38",
      "name": "Pobierz stany magazynowe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-WMS.example.com/api/stock",
        "sendBody": false,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Podmień na Baselinker/Shopify/WMS."
    },
    {
      "id": "3663c790-0d97-4e02-be34-7d3d573d0e2d",
      "name": "Stan poniżej progu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "87e6bbec-e0df-45b0-a059-d09f7c68ee56",
              "leftValue": "={{ $json.quantity }}",
              "rightValue": 10,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9264c0bc-c9b2-40b4-91ec-7c0e038df1a1",
      "name": "Alert niskiego stanu",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "mode": "name",
          "value": "#automatyzacje"
        },
        "text": "📦 Niski stan magazynowy: {{$json.productName}} ({{$json.quantity}} szt.)",
        "otherOptions": {}
      }
    }
  ],
  "connections": {
