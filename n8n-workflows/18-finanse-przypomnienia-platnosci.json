{
  "name": "STFS — Przypomnienia o nieopłaconych fakturach",
  "nodes": [
    {
      "id": "11e1b2aa-dfdb-44a7-a16b-5a70de152751",
      "name": "Notatka: konfiguracja",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        -40
      ],
      "parameters": {
        "content": "## Przypomnienia o płatnościach\n\n**Trigger:** Schedule — codzienna kontrola.\n\n**Do zrobienia:**\n1. Podmień \"Pobierz nieopłacone faktury\" na API systemu księgowego.\n2. Dostosuj liczbę dni po terminie w węźle IF.",
        "height": 300,
        "width": 380,
        "color": 4
      }
    },
    {
      "id": "a0a24115-d896-483c-9fbd-d229bee4b5d9",
      "name": "Codziennie 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "8d9c5819-20fe-44af-b079-15c5a1e2bd0e",
      "name": "Pobierz nieopłacone faktury",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-BILLING.example.com/api/invoices?status=unpaid",
        "sendBody": false,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Podmień na realny system księgowy."
    },
    {
      "id": "80dc09a5-4e32-4049-9dcd-c8b4f28ed8f3",
      "name": "Termin minął?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "33784a4e-306d-4380-bb93-8d8507837781",
              "leftValue": "={{ $json.daysOverdue }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "2cdf1fbf-0c30-46c5-b1fc-b2f380a4cfdf",
      "name": "Wyślij przypomnienie",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        860,
        300
      ],
      "parameters": {
        "fromEmail": "hello@stfs.studio",
        "toEmail": "={{ $json.email }}",
        "subject": "Przypomnienie o płatności",
        "text": "Faktura {{$json.number}} jest przeterminowana o {{$json.daysOverdue}} dni.",
        "options": {}
      }
    }
  ],
  "connections": {
    "Codziennie 9:00": {
      "main": [
        [
          {
            "node": "Pobierz nieopłacone faktury",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pobierz nieopłacone faktury": {
      "main": [
        [
          {
            "node": "Termin minął?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Termin minął?": {
      "main": [
        [
          {
            "node": "Wyślij przypomnienie",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}