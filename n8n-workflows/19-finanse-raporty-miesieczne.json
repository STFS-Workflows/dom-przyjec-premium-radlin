{
  "name": "STFS — Raporty finansowe na koniec miesiąca",
  "nodes": [
    {
      "id": "a8fea23f-1ba9-4371-b608-918069b6bd9a",
      "name": "Notatka: konfiguracja",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        -40
      ],
      "parameters": {
        "content": "## Raport finansowy miesięczny\n\n**Trigger:** Schedule — 1. dzień miesiąca.\n\n**Do zrobienia:**\n1. Podmień \"Pobierz dane finansowe\" na API systemu księgowego.\n2. Podmień odbiorcę raportu (Slack/e-mail) na właściwą osobę.",
        "height": 300,
        "width": 380,
        "color": 4
      }
    },
    {
      "id": "502629c2-1a69-4ea0-88be-c61348824530",
      "name": "1. dzień miesiąca 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 1 * *"
            }
          ]
        }
      }
    },
    {
      "id": "59bd10f3-d890-4815-9bc2-d11bd903f401",
      "name": "Pobierz dane finansowe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-ACCOUNTING.example.com/api/summary",
        "sendBody": false,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Podmień na realny system księgowy."
    },
    {
      "id": "0d88d168-d0e8-4702-b6fd-0448c9b181b6",
      "name": "AI: napisz podsumowanie",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Model tworzy czytelne podsumowanie miesiąca z kluczowymi liczbami."
    },
    {
      "id": "9fdb08ea-8ba1-4e66-9b21-b246c9b1cd29",
      "name": "Wyślij raport",
