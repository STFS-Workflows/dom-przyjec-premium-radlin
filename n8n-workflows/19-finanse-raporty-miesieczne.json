        860,
        300
      ],
      "parameters": {
        "fromEmail": "hello@stfs.studio",
        "toEmail": "ceo@twojafirma.pl",
        "subject": "Raport finansowy — miesiąc",
        "text": "={{ $json.aiResponse }}",
        "options": {}
      }
    }
