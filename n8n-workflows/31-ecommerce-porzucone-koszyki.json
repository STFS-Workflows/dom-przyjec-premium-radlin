{
  "name": "STFS — Przypomnienia o porzuconym koszyku",
  "nodes": [
    {
      "id": "b4c74999-7bb0-4b42-9946-8b82666615c5",
      "name": "Notatka: konfiguracja",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        80,
        -40
      ],
      "parameters": {
        "content": "## Porzucone koszyki\n\n**Trigger:** Schedule — sprawdza koszyki porzucone 1h+ temu.\n\n**Do zrobienia:**\n1. Podmień \"Pobierz porzucone koszyki\" na API sklepu (Shopify/WooCommerce).\n2. Skonfiguruj SMTP do wysyłki przypomnienia.",
        "height": 300,
        "width": 380,
        "color": 4
      }
    },
    {
      "id": "1f1d7d4f-0152-466c-84f6-3ecc0a8f1a5b",
      "name": "Co godzinę",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "092119d4-57a8-4900-b68d-11009732ccfe",
      "name": "Pobierz porzucone koszyki",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://YOUR-SHOP.example.com/api/carts/abandoned",
        "sendBody": false,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Podmień na Shopify/WooCommerce API."
    },
    {
      "id": "d8ea0332-adda-4833-9f9d-7676c8c2af96",
      "name": "AI: napisz spersonalizowaną wiadomość",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "notes": "Podmień na węzeł dostawcy AI (OpenAI/Claude/inny) lub uzupełnij Authorization: Bearer w Headers. To placeholder pokazujący, gdzie w przepływie wchodzi model językowy."
    },
    {
      "id": "231deddc-a274-411c-beb8-0ceeab537db3",
      "name": "Wyślij przypomnienie",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        860,
        300
      ],
      "parameters": {
        "fromEmail": "hello@stfs.studio",
        "toEmail": "={{ $json.email }}",
        "subject": "Zostawiłeś/aś coś w koszyku",
        "text": "={{ $json.aiResponse }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Co godzinę": {
      "main": [
        [
          {
            "node": "Pobierz porzucone koszyki",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pobierz porzucone koszyki": {
      "main": [
        [
          {
            "node": "AI: napisz spersonalizowaną wiadomość",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI: napisz spersonalizowaną wiadomość": {
      "main": [
        [
          {
            "node": "Wyślij przypomnienie",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}